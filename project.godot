; STICKMAN - Godot 4 project
config_version=5

[application]
config/name="STICKMAN: SHADOW WORLD"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="Original 3D open-world mobile adventure"

[autoload]
GameState="*res://scripts/game_state.gd"
SaveSystem="*res://scripts/save_system.gd"
AudioManager="*res://scripts/audio_manager.gd"

[display]
window/handheld/orientation=0
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.11, 1)
